---
import SignalLayout from '../layouts/SignalLayout.astro';
---

<SignalLayout title="AI disclosure – OpenTubeX" description="How OpenTubeX uses AI-assisted development tools." active="ai-disclosure">
	<main class="resource-page">
		<header class="page-hero">
			<div class="page-hero__signal" aria-hidden="true">
				<svg viewBox="0 0 1440 320" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
					<g transform="translate(980 160)">
						<path class="wave-path wave-path--b" d="M-460 20 Q-300 -50 -140 20 T180 20 T460 20"></path>
						<path class="wave-path wave-path--a" d="M-500 50 Q-320 -20 -140 50 T220 50 T500 50"></path>
						<path class="wave-path wave-path--b" d="M-380 -30 Q-250 -90 -120 -30 T140 -30 T380 -30"></path>
						<path class="wave-path wave-path--a" d="M-300 -70 Q-190 -120 -80 -70 T140 -70 T300 -70"></path>
						<g fill="var(--teal)">
							<circle cx="-140" cy="20" r="3" opacity="0.65"></circle>
							<circle cx="0" cy="-30" r="2.5" opacity="0.45"></circle>
							<circle cx="140" cy="20" r="3" opacity="0.65"></circle>
						</g>
					</g>
				</svg>
			</div>
			<div class="page-hero__mesh" aria-hidden="true"></div>
			<div class="page-hero__content">
				<p class="page-hero__eyebrow">How OpenTubeX is built</p>
				<h1 class="page-hero__title">AI-assisted development</h1>
			</div>
		</header>
		<section class="section disclosure-section" aria-label="AI disclosure">
			<div class="disclosure-copy">
				<p>
					OpenTubeX is developed extensively with AI-assisted tools. This allows our small maintainer team
					to develop features, fix bugs, and iterate much more rapidly. The source code remains open for
					anyone to inspect, review, modify, or fork.
				</p>
				<p>
					This refers to how OpenTubeX is developed. It does not mean the app sends your viewing data to
					an AI service. If AI-assisted development does not align with your preferences, OpenTubeX may
					simply not be the right project for you.
				</p>
			</div>
		</section>
	</main>
</SignalLayout>

<style>
	.disclosure-section { padding-block: 3rem; }
	.disclosure-copy {
		max-width: 62ch;
		color: var(--slate);
		line-height: 1.75;
	}
	.disclosure-copy p + p { margin-top: 1.1rem; }
</style>
