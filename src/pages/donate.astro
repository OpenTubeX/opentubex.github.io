---
import { Icon } from 'astro-icon/components';
import { renderSVG } from 'uqr';
import SignalLayout from '../layouts/SignalLayout.astro';

const platforms = [
	{
		name: 'GitHub Sponsors',
		icon: 'simple-icons:github',
		href: 'https://github.com/sponsors/D3SOX',
		body: 'Sponsor monthly or once with your GitHub account. GitHub takes no fee from sponsorships by personal accounts.',
		action: 'Sponsor on GitHub',
	},
	{
		name: 'Liberapay',
		icon: 'simple-icons:liberapay',
		href: 'https://liberapay.com/D3SOX',
		body: 'Give weekly, monthly, or yearly without a GitHub account. For a one-time donation, cancel right after the first payment. A nonprofit runs Liberapay, and its code is open source.',
		action: 'Donate on Liberapay',
	},
] as const;

// The QR codes encode payment URIs so wallets fill in the right currency.
const coins = [
	{
		name: 'Monero',
		icon: 'simple-icons:monero',
		address: '85uRNN3gUGvD6MBMUEvBTcTjCKV6YuWDs1kVfWLBsgR86X2dbzxmQQmhaT66zecdKEhX9UrZguAUB6pH2ncYDFznCB1gY3N',
		uri: 'monero:',
		body: 'Monero hides the sender, the recipient, and the amount, so nobody else can see your donation.',
	},
	{
		name: 'Bitcoin',
		icon: 'simple-icons:bitcoin',
		address: 'bc1qgjwumk5ufvhmrw94elef6945qe8m2swkqz3958',
		uri: 'bitcoin:',
		body: 'Bitcoin payments are public on the blockchain, including the amount. To donate privately, use Monero.',
	},
].map((coin) => ({ ...coin, qr: renderSVG(coin.uri + coin.address, { border: 2 }) }));
---

<SignalLayout title="Donate – OpenTubeX" description="Support OpenTubeX with a donation through GitHub Sponsors, Liberapay, Monero, or Bitcoin." active="donate">
	<main class="resource-page">
		<header class="page-hero">
			<div class="page-hero__signal" aria-hidden="true">
				<svg viewBox="0 0 1440 320" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
					<g transform="translate(980 160)">
						<path class="wave-path wave-path--b" d="M-460 20 Q-300 -50 -140 20 T180 20 T460 20"></path>
						<path class="wave-path wave-path--a" d="M-500 50 Q-320 -20 -140 50 T220 50 T500 50"></path>
						<path class="wave-path wave-path--b" d="M-380 -30 Q-250 -90 -120 -30 T140 -30 T380 -30"></path>
						<path class="wave-path wave-path--a" d="M-300 -70 Q-190 -120 -80 -70 T140 -70 T300 -70"></path>
						<g fill="var(--accent)">
							<circle cx="-140" cy="20" r="3" opacity="0.65"></circle>
							<circle cx="0" cy="-30" r="2.5" opacity="0.45"></circle>
							<circle cx="140" cy="20" r="3" opacity="0.65"></circle>
						</g>
					</g>
				</svg>
			</div>
			<div class="page-hero__mesh" aria-hidden="true"></div>
			<div class="page-hero__content">
				<p class="page-hero__eyebrow">Donate</p>
				<h1 class="page-hero__title">Support OpenTubeX</h1>
				<p class="page-hero__lede">
					If you find OpenTubeX useful, a donation helps fund its development.
				</p>
			</div>
		</header>

		<section class="section section--page" aria-labelledby="donate-heading">
			<h2 class="section__title reveal" id="donate-heading">Choose how to donate</h2>

			<div class="pillars">
				{
					platforms.map(({ name, icon, href, body, action }) => (
						<article class="pillar pillar--linked">
							<span class="pillar__mark" aria-hidden="true">
								<span class="pebble"><Icon name={icon} /></span>
							</span>
							<div>
								<h3 class="pillar__title"><a href={href} rel="noopener noreferrer">{name}</a></h3>
								<p class="pillar__body">{body}</p>
							</div>
							<a class="btn btn--primary" href={href} rel="noopener noreferrer">
								<Icon name="lucide:heart" aria-hidden="true" />
								{action}
							</a>
						</article>
					))
				}
				{
					coins.map(({ name, icon, address, body, qr }) => (
						<article class="pillar pillar--linked pillar--coin">
							<span class="pillar__mark" aria-hidden="true">
								<span class="pebble"><Icon name={icon} /></span>
							</span>
							<div class="coin">
								<h3 class="pillar__title">{name}</h3>
								<p class="pillar__body">{body}</p>
								<code class="coin__address" aria-label={`${name} address`}>{address}</code>
								<button class="btn btn--ghost coin__copy" type="button" data-copy-address={address}>
									<Icon class="coin__copy-icon" name="lucide:copy" aria-hidden="true" />
									<Icon class="coin__copied-icon" name="lucide:check" aria-hidden="true" />
									<span data-copy-label>Copy address</span>
								</button>
							</div>
							<figure class="coin__qr" role="img" aria-label={`QR code for the ${name} address`} set:html={qr} />
						</article>
					))
				}
			</div>

			<p class="section__intro donate-other reveal">
				You can also help without paying: <a href="https://hosted.weblate.org/engage/opentubex/" rel="noopener noreferrer">translate OpenTubeX</a>,{' '}
				<a href="https://github.com/OpenTubeX/OpenTubeX/issues" rel="noopener noreferrer">report bugs</a>,{' '}
				<a href="https://github.com/OpenTubeX/OpenTubeX" rel="noopener noreferrer">star it on GitHub</a>, or just spread the word.
			</p>
		</section>
	</main>
</SignalLayout>

<style>
	.section--page .donate-other { max-width: none; margin-top: 2rem; }

	.coin { min-width: 0; }

	.coin__address {
		display: block;
		max-width: 52ch;
		margin-top: 0.9rem;
		padding: 0.6rem 0.75rem;
		border: 1px solid var(--line);
		border-radius: 0.6rem;
		background: var(--surface);
		font-family: var(--font-mono);
		font-size: 0.85rem;
		line-height: 1.5;
		overflow-wrap: anywhere;
		user-select: all;
	}

	.coin__copy { margin-top: 0.75rem; }

	/* Copying needs the script, and the address can still be selected without it. */
	:global(html:not(.js)) .coin__copy { display: none; }

	.coin__copied-icon,
	.coin__copy.is-copied .coin__copy-icon { display: none; }

	.coin__copy.is-copied .coin__copied-icon { display: block; }

	/* Dark-on-light in both themes, which every scanner reads. */
	.coin__qr {
		width: 9.5rem;
		margin: 0;
		padding: 0.35rem;
		border-radius: 0.7rem;
		background: #ffffff;
		line-height: 0;
	}

	.coin__qr :global(svg) { width: 100%; height: auto; }

	@media (max-width: 820px) {
		.pillar--linked > .btn,
		.coin__qr { grid-column: 2; justify-self: start; }
	}

	@media (max-width: 640px) {
		.pillar--linked > .btn { grid-column: 1 / -1; justify-self: stretch; }
		.coin__qr { justify-self: center; }
	}
</style>

<script>
	document.addEventListener('click', async (event) => {
		const button = event.target instanceof Element ? event.target.closest<HTMLButtonElement>('[data-copy-address]') : null;
		const label = button?.querySelector('[data-copy-label]');
		if (!button || !label) return;

		try {
			await navigator.clipboard.writeText(button.dataset.copyAddress ?? '');
		} catch {
			label.textContent = 'Select the address to copy it';
			return;
		}

		button.classList.add('is-copied');
		label.textContent = 'Copied';
		setTimeout(() => {
			button.classList.remove('is-copied');
			label.textContent = 'Copy address';
		}, 2000);
	});
</script>
