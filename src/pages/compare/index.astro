---
import SignalLayout from '../../layouts/SignalLayout.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import '../../styles/comparisons.css';
---

<SignalLayout title="YouTube client alternatives – OpenTubeX" description="Compare desktop and mobile YouTube clients by privacy, data import, sync, downloads, and tabs. Each table entry links to a source where possible." active="compare">
	<main class="resource-page comparison-page">
		<header class="page-hero">
			<div class="page-hero__content">
				<p class="page-hero__eyebrow">Client comparison</p>
				<h1 class="page-hero__title">Compare YouTube clients</h1>
				<p class="page-hero__lede">This table compares OpenTubeX with FreeTube, Grayjay, NewPipe, LibreTube, Flow, NewTube, Morphe, and YouTube. It covers platforms, privacy, playback, and library tools for people looking at FreeTube alternatives.</p>
			</div>
		</header>
		<section class="section section--page comparison-results" aria-labelledby="comparison-results-heading">
			<h2 class="section__title" id="comparison-results-heading">What each client supports</h2>
			<ComparisonTable />
			<p class="comparison-note">
				Maintained by OpenTubeX. Sources checked <time datetime="2026-11-13">13 November 2026</time>. Support can vary by release and platform.
				<br />
				Third-party names and logos are the property of their respective owners and appear here only to identify the products compared. OpenTubeX is not affiliated with or endorsed by those owners.
			</p>
		</section>
	</main>
</SignalLayout>
