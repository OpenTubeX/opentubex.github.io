---
import SignalLayout from '../layouts/SignalLayout.astro';
import { Icon } from 'astro-icon/components';
import '../styles/not-found.css';

const upNext = [
	{ href: '/downloads/', title: 'Downloads', body: 'Get OpenTubeX for desktop, Android, and iOS', icon: 'lucide:download' },
	{ href: '/extra-features/', title: 'Features', body: 'Everything OpenTubeX adds, with screenshots', icon: 'lucide:sparkles' },
	{ href: '/demo/', title: 'Demo', body: 'Try the web app in your browser', icon: 'lucide:monitor-play' },
	{ href: '/docs/', title: 'Docs', body: 'Install, import your library, and fix problems', icon: 'lucide:book-open' },
	{ href: '/compare/', title: 'Compare', body: 'See how other YouTube clients stack up', icon: 'lucide:columns-2' },
];
---

<SignalLayout
	title="Page not found – OpenTubeX"
	description="This page does not exist on the OpenTubeX site."
>
	<main class="not-found">
		<div class="not-found__watch">
			<div class="not-found__player" aria-hidden="true">
				<div class="not-found__screen">
					<span class="not-found__code">404</span>
					<span class="not-found__caption">[no signal]</span>
				</div>
				<div class="not-found__controls">
					<div class="not-found__seek">
						<span></span>
						<span class="not-found__missing"></span>
						<span></span>
					</div>
					<div class="not-found__buttons">
						<Icon name="lucide:play" />
						<Icon name="lucide:volume-2" class="not-found__volume" />
						<span class="not-found__time">0:00 / 4:04</span>
						<span class="not-found__chapter">Missing chapter</span>
						<Icon name="lucide:captions" class="not-found__cc" />
						<Icon name="lucide:settings" />
						<Icon name="lucide:maximize" />
					</div>
				</div>
			</div>
			<h1 class="not-found__title">This page isn't available</h1>
			<p class="not-found__lede">Nothing is published at this address. The link may be mistyped or out of date, or the page may have moved.</p>
			<div class="cta-group">
				<a class="btn btn--primary" href="/">
					<Icon name="lucide:house" aria-hidden="true" />
					Back home
				</a>
				<a class="btn btn--ghost" href="https://github.com/OpenTubeX/opentubex.github.io/issues/new">
					<Icon name="lucide:flag" aria-hidden="true" />
					Report a broken link
				</a>
			</div>
		</div>
		<nav class="not-found__next" aria-labelledby="up-next-heading">
			<h2 id="up-next-heading">Up next</h2>
			<ul>
				{upNext.map((item) => (
					<li>
						<a href={item.href}>
							<span class="not-found__thumb"><Icon name={item.icon} aria-hidden="true" /></span>
							<span class="not-found__item-title">{item.title}</span>
							<span class="not-found__item-body">{item.body}</span>
						</a>
					</li>
				))}
			</ul>
		</nav>
	</main>
</SignalLayout>
