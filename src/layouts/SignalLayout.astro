---
import '../styles/signal.css';
import '../styles/resources.css';
import { Font } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import ImageLightbox from '../components/ImageLightbox.astro';
import ThemeSelect from '../components/ThemeSelect.astro';
import markDark from '../assets/mark-dark.svg';
import markLight from '../assets/mark-light.svg';
import osaBadge from '../assets/osa-badge.svg';
// Inlined so it never pairs with stale markup and needs no render-blocking request.
import themeScript from '../scripts/theme.js?raw';

type Active = 'home' | 'docs' | 'downloads' | 'features' | 'compare' | 'changelog' | 'privacy' | 'ai-disclosure';

interface Props {
	title: string;
	description: string;
	active?: Active | null;
}

const { title, description, active = null } = Astro.props;

const markDarkSrc = typeof markDark === 'string' ? markDark : markDark.src;
const markLightSrc = typeof markLight === 'string' ? markLight : markLight.src;

const social = [
	{ href: 'https://github.com/OpenTubeX', label: 'GitHub', icon: 'simple-icons:github' },
	{ href: 'https://weblate.opentubex.org/engage/opentubex/', label: 'Weblate', icon: 'simple-icons:weblate' },
	{ href: 'https://fluxer.opentubex.org', label: 'Fluxer', icon: 'simple-icons:fluxer' },
	{ href: 'https://matrix.opentubex.org', label: 'Matrix', icon: 'simple-icons:matrix' },
] as const;

const primaryNav = [
	{ href: '/', label: 'Home', id: 'home', icon: 'lucide:house' },
	{ href: '/downloads/', label: 'Downloads', id: 'downloads', icon: 'lucide:download' },
	{ href: '/extra-features/', label: 'Features', id: 'features', icon: 'lucide:sparkles' },
	{ href: '/docs/', label: 'Docs', id: 'docs', icon: 'lucide:book-open' },
	{ href: '/compare/', label: 'Compare', id: 'compare', icon: 'lucide:columns-2' },
	{ href: '/changelog/', label: 'Changelog', id: 'changelog', icon: 'lucide:history' },
] as const;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<script is:inline>
			(function () {
				document.documentElement.classList.add('js');
				try {
					var KEY = 'otx-theme';
					var LEGACY_KEY = 'otx-redesign-theme';
					var stored = localStorage.getItem(KEY);
					if (stored === null || stored === '') {
						var legacy = localStorage.getItem(LEGACY_KEY);
						if (legacy === 'light' || legacy === 'dark') stored = legacy;
						else stored = 'auto';
					}
					var theme =
						stored === 'light' || stored === 'dark'
							? stored
							: matchMedia('(prefers-color-scheme: dark)').matches
								? 'dark'
								: 'light';
					document.documentElement.dataset.theme = theme;
				} catch (e) {
					document.documentElement.dataset.theme = 'dark';
				}
			})();
		</script>
		<title>{title}</title>
		<meta name="description" content={description} />
		<Font cssVariable="--font-body" preload={[{ weight: 400, subset: 'latin' }]} />
		<Font cssVariable="--font-display" preload={[{ weight: 600, subset: 'latin' }]} />
		<Font cssVariable="--font-mono" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="16x16 32x32 48x48 64x64" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	</head>
	<body class="signal-body">
		<div class="page-bg" aria-hidden="true"></div>

		<header class="nav" id="nav">
			<div class="nav__inner">
				<a class="nav__brand" href="/" aria-label="OpenTubeX home">
					<picture>
						<source data-logo-theme="dark" media="(prefers-color-scheme: dark)" srcset={markDarkSrc} type="image/svg+xml" />
						<img src={markLightSrc} alt="" width="32" height="32" />
					</picture>
					<span>OpenTubeX</span>
				</a>
				<nav class="nav__links" id="nav-links" aria-label="Primary">
					{
						primaryNav.map(({ href, label, id, icon }) => (
							<a
								href={href}
								class:list={[{ 'is-active': active === id }]}
								aria-current={active === id ? 'page' : undefined}
							>
								<Icon class="nav__link-icon" name={icon} aria-hidden="true" />
								{label}
							</a>
						))
					}
					<div class="nav__actions">
						<nav class="nav__community-links" aria-label="Community">
							{
								social.map(({ href, label, icon }) => (
									<a href={href} rel="noopener noreferrer" aria-label={label} title={label}>
										<span class="sr-only">{label}</span>
										<Icon name={icon} />
									</a>
								))
							}
						</nav>
						<ThemeSelect />
					</div>
				</nav>
				<button class="nav__toggle" type="button" aria-expanded="false" aria-controls="nav-links" aria-label="Menu">
					<span></span><span></span><span></span>
				</button>
			</div>
		</header>

		<div class="page-shell">
			<slot />
		</div>

		<footer class="site-footer">
			<div class="site-footer__inner">
				<div class="site-footer__about">
					<a class="site-footer__brand" href="/">
						<picture>
							<source data-logo-theme="dark" media="(prefers-color-scheme: dark)" srcset={markDarkSrc} type="image/svg+xml" />
							<img src={markLightSrc} alt="" width="28" height="28" />
						</picture>
						OpenTubeX
					</a>
					<p>Privacy-first YouTube client</p>
					<a class="site-footer__badge" href="https://www.opensourcealternatives.to/item/opentubex" rel="noopener noreferrer">
						<img src={osaBadge.src} alt="As seen on Open Source Alternatives" width="270" height="20" loading="lazy" decoding="async" />
					</a>
				</div>
				<div class="site-footer__col">
					<h2>Like OpenTubeX?</h2>
					<ul>
						<li>
							<a href="https://github.com/OpenTubeX/OpenTubeX" rel="noopener noreferrer">
								<Icon name="lucide:star" aria-hidden="true" />
								Star on GitHub
							</a>
						</li>
						<li>
							<a href="https://alternativeto.net/software/opentubex/about/" rel="noopener noreferrer">
								<Icon name="simple-icons:alternativeto" aria-hidden="true" />
								Like &amp; review on AlternativeTo
							</a>
						</li>
					</ul>
				</div>
				<nav class="site-footer__col" aria-labelledby="footer-legal-heading">
					<h2 id="footer-legal-heading">Legal</h2>
					<ul>
						<li><a href="/ai-disclosure/" aria-current={active === 'ai-disclosure' ? 'page' : undefined}>AI disclosure</a></li>
						<li><a href="/privacy/" aria-current={active === 'privacy' ? 'page' : undefined}>Privacy policy</a></li>
					</ul>
				</nav>
			</div>
		</footer>

		<ImageLightbox />

		<script is:inline>
			(function () {
				var nav = document.getElementById('nav');
				var toggle = nav.querySelector('.nav__toggle');
				var links = document.getElementById('nav-links');

				toggle.addEventListener('click', function () {
					var open = nav.classList.toggle('is-open');
					toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
				});

				links.querySelectorAll('a').forEach(function (a) {
					a.addEventListener('click', function () {
						nav.classList.remove('is-open');
						toggle.setAttribute('aria-expanded', 'false');
					});
				});

				var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
				var targets = Array.from(document.querySelectorAll('.pillar, .pkg, .reveal'));

				if (reduce || !('IntersectionObserver' in window)) {
					targets.forEach(function (el) {
						el.classList.add('is-visible');
					});
					document.querySelectorAll('animate').forEach(function (el) {
						el.remove();
					});
					return;
				}

				var nextRevealAt = 0;
				var observer = new IntersectionObserver(
					function (entries) {
						// Stagger each newly visible batch in page order, without wrapping mid-row.
						var visible = entries.filter(function (entry) { return entry.isIntersecting; });
						visible.sort(function (a, b) { return targets.indexOf(a.target) - targets.indexOf(b.target); });
						// Quick scrolling can deliver another batch before the previous one has started.
						var now = performance.now();
						nextRevealAt = Math.max(nextRevealAt, now);
						visible.forEach(function (entry) {
							entry.target.style.transitionDelay = (nextRevealAt - now) / 1000 + 's';
							nextRevealAt += 50;
							entry.target.classList.add('is-visible');
							observer.unobserve(entry.target);
						});
					},
					{ rootMargin: '0px 0px -40px 0px', threshold: 0 },
				);

				targets.forEach(function (el) {
					observer.observe(el);
				});
			})();
		</script>
		<script is:inline set:html={themeScript}></script>
		<script>
			import '../scripts/animations';
			import '../scripts/email-reveal';
		</script>
	</body>
</html>
