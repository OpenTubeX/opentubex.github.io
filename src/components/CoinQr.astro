---
import { Icon } from 'astro-icon/components';
import markDark from '../assets/mark-dark.svg';
import type { BrandedQr } from '../lib/branded-qr';

interface Props {
	name: string;
	icon: string;
	color: string;
	qr: BrandedQr;
}

const { name, icon, color, qr } = Astro.props;
const markSrc = typeof markDark === 'string' ? markDark : markDark.src;
---

<span
	class="coin-qr"
	role="img"
	aria-label={`QR code for the ${name} address`}
	style={`--logo-size: ${qr.logoSize * 100}%; --coin-color: ${color}`}
>
	<Fragment set:html={qr.svg} />
	<span class="coin-qr__logo" aria-hidden="true">
		<span class="coin-qr__mark"><img src={markSrc} alt="" /></span>
		<span class="coin-qr__badge"><Icon name={icon} /></span>
	</span>
</span>

<style>
	/* Colors come from the --qr-* properties of an ancestor, so the page can
	   switch every copy of a code between its light and dark version. The SVG's
	   quiet zone pads the code, so the logo size is a share of the code's width. */
	.coin-qr {
		position: relative;
		display: block;
		width: 100%;
		border-radius: 1rem;
		background: var(--qr-bg, #ffffff);
		box-shadow:
			0 0 0 1px var(--line),
			0 0.75rem 1.75rem -0.9rem var(--accent-glow);
		line-height: 0;
	}

	.coin-qr :global(svg) { width: 100%; height: auto; }
	.coin-qr :global(.qr-modules) { stroke: var(--qr-ink, #1a1a1a); }
	.coin-qr :global(.qr-eyes) { stroke: var(--qr-eye, #b8291c); }
	.coin-qr :global(.qr-eye-dot) { fill: var(--qr-eye, #b8291c); stroke: none; }

	.coin-qr__logo {
		position: absolute;
		top: 50%;
		left: 50%;
		width: var(--logo-size);
		aspect-ratio: 1;
		translate: -50% -50%;
	}

	.coin-qr__mark {
		position: absolute;
		inset: 8%;
		display: grid;
		place-items: center;
		border-radius: 28%;
		background: var(--button-primary-bg);
	}

	.coin-qr__mark img { width: 66%; height: auto; }

	.coin-qr__badge {
		position: absolute;
		right: -4%;
		bottom: -4%;
		width: 46%;
		aspect-ratio: 1;
		border-radius: 50%;
		background: var(--qr-bg, #ffffff);
		box-shadow: 0 0 0 1.5px var(--qr-bg, #ffffff);
		color: var(--coin-color);
	}

	.coin-qr__badge :global(svg) { display: block; width: 100%; height: 100%; }
</style>
