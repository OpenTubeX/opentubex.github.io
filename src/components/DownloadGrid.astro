---
import { Icon } from 'astro-icon/components';
import { allReleasesUrl, downloadGroups } from '../data/release';
---

<section class="download-grid not-content" aria-label="OpenTubeX downloads">
	{
		downloadGroups.map((group) => (
			<div class="download-card-shell">
				<article class="download-card">
					<div class="platform-mark" aria-hidden="true">
						<Icon name={group.icon} />
					</div>
					<div class="download-card-content">
						<h3>{group.title}</h3>
						<div class="download-links">
							{group.links.map((link) => (
								<a href={link.url} rel={link.isExternal ? 'noreferrer' : undefined}>
									{link.label}
								</a>
							))}
						</div>
					</div>
				</article>
			</div>
		))
	}
</section>

<p class="download-footnote not-content">
	You can also browse <a href={allReleasesUrl}>all GitHub releases</a> or build
	OpenTubeX from source for any supported platform.
</p>

<style>
	.download-grid {
		align-items: stretch;
		display: grid;
		gap: 1rem;
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.download-card-shell {
		display: flex;
		min-height: 100%;
	}

	.download-card {
		background: var(--sl-color-bg-nav);
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1.25rem;
		box-sizing: border-box;
		display: flex;
		flex: 1;
		gap: 1rem;
		padding: 1.25rem;
		width: 100%;
	}

	.platform-mark {
		align-items: center;
		align-self: flex-start;
		aspect-ratio: 1;
		background: var(--sl-color-accent-low);
		border-radius: 1rem;
		color: var(--sl-color-accent-high);
		display: flex;
		flex: 0 0 4rem;
		font-size: 2rem;
		justify-content: center;
	}

	.platform-mark :global(svg) {
		height: 2rem;
		width: 2rem;
	}

	.download-card-content {
		display: flex;
		flex: 1;
		flex-direction: column;
		min-width: 0;
	}

	.download-card h3 {
		font-size: 1.2rem;
		margin: 0 0 0.85rem;
	}

	.download-links {
		align-content: flex-start;
		display: flex;
		flex: 1;
		flex-wrap: wrap;
		gap: 0.45rem;
	}

	.download-links a {
		background: var(--sl-color-gray-6);
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		color: var(--sl-color-white);
		font-size: 0.86rem;
		font-weight: 650;
		line-height: 1.2;
		padding: 0.45rem 0.6rem;
		text-decoration: none;
		transition:
			background-color 120ms ease,
			border-color 120ms ease,
			transform 120ms ease;
	}

	.download-links a:hover,
	.download-links a:focus-visible {
		background: var(--sl-color-accent-low);
		border-color: var(--sl-color-accent);
		transform: translateY(-1px);
	}

	.download-footnote {
		color: var(--sl-color-gray-2);
		margin-top: 1.5rem;
		text-align: center;
	}

	@media (max-width: 42rem) {
		.download-grid {
			grid-template-columns: 1fr;
		}

		.download-card {
			flex-direction: column;
		}
	}
</style>
