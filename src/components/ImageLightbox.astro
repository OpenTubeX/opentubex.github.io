---
import 'photoswipe/style.css';
---

<script>
	type GalleryElement = HTMLElement & { imageLightboxController?: AbortController };
	type GalleryItem = HTMLImageElement | HTMLVideoElement;

	/** Build-time videos replacing animated images play as custom slides. */
	function videoSlide(video: HTMLVideoElement) {
		const slide = document.createElement('video');
		slide.src = video.currentSrc || video.src;
		for (const name of ['muted', 'loop', 'playsinline']) slide.setAttribute(name, '');
		slide.setAttribute('aria-label', video.getAttribute('aria-label') ?? '');
		slide.style.cssText = 'width: 100%; height: 100%;';
		return slide.outerHTML;
	}

	function initImageLightboxes() {
		document.querySelectorAll<GalleryElement>('[data-image-gallery]').forEach((gallery) => {
			gallery.imageLightboxController?.abort();
			const controller = new AbortController();
			gallery.imageLightboxController = controller;

			// Reduced-motion users get native controls on videos instead, which clicks must reach.
			const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			const images = [...gallery.querySelectorAll<GalleryItem>(reducedMotion ? 'img' : 'img, video.animation')].filter(
				(image) => !image.closest('a[href]'),
			);
			let lightboxActive = false;
			images.forEach((image) => {
				image.classList.add('zoomable-image');
				// ARIA forbids button semantics on video, so animations only open by pointer.
				if (image instanceof HTMLVideoElement) return;
				image.tabIndex = image.getAttribute('aria-hidden') === 'true' ? -1 : 0;
				image.setAttribute('role', 'button');
				image.setAttribute('aria-label', `Open ${image.alt || 'image'} fullscreen`);
			});

			async function openImage(image: GalleryItem) {
				if (lightboxActive) return;
				lightboxActive = true;

				try {
					if (image instanceof HTMLImageElement && !image.complete) {
						await image.decode().catch(() => undefined);
					}

					const PhotoSwipe = (await import('photoswipe')).default;
					const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
					// Skip theme variants hidden by CSS.
					const items = images.filter((item) => item instanceof HTMLImageElement || item.getClientRects().length > 0);
					const dataSource = items.map((item) => item instanceof HTMLVideoElement ? {
						html: videoSlide(item),
						width: Number(item.dataset.fullWidth) || item.videoWidth || item.clientWidth,
						height: Number(item.dataset.fullHeight) || item.videoHeight || item.clientHeight,
					} : {
						src: item.dataset.fullSrc || item.currentSrc || item.src,
						msrc: item.currentSrc || item.src,
						width:
							Number(item.dataset.fullWidth) ||
							item.naturalWidth ||
							Number(item.getAttribute('width')) ||
							item.clientWidth,
						height:
							Number(item.dataset.fullHeight) ||
							item.naturalHeight ||
							Number(item.getAttribute('height')) ||
							item.clientHeight,
						alt: item.alt,
					});

					const lightbox = new PhotoSwipe({
						dataSource,
						index: items.indexOf(image),
						bgOpacity: 0.94,
						spacing: 0.14,
						wheelToZoom: true,
						showHideAnimationType: prefersReducedMotion ? 'none' : 'fade',
					});

					if (!prefersReducedMotion) {
						lightbox.goTo = (index) => {
							const distance = lightbox.getLoopedIndex(index) - lightbox.potentialIndex;
							lightbox.mainScroll.moveIndexBy(distance, true);
						};
					}

					// Play only the current slide's video; neighbouring slides are preloaded.
					const syncVideos = () => {
						const current = lightbox.currSlide?.container.querySelector('video');
						lightbox.element?.querySelectorAll('video').forEach((video) => video !== current && video.pause());
						void current?.play().catch(() => undefined);
					};
					lightbox.on('change', syncVideos);
					// Slide content is appended after this event fires.
					lightbox.on('contentAppend', () => requestAnimationFrame(syncVideos));
					lightbox.on('destroy', () => {
						lightboxActive = false;
					});
					lightbox.init();
				} catch (error) {
					lightboxActive = false;
					console.error('Unable to open image lightbox', error);
				}
			}

			gallery.addEventListener(
				'click',
				(event) => {
					const image = (event.target as Element).closest<GalleryItem>('.zoomable-image');
					if (!image) return;
					event.preventDefault();
					void openImage(image);
				},
				{ signal: controller.signal },
			);

			gallery.addEventListener(
				'keydown',
				(event) => {
					if (event.key !== 'Enter' && event.key !== ' ') return;
					const image = (event.target as Element).closest<GalleryItem>('.zoomable-image');
					if (!image) return;
					event.preventDefault();
					void openImage(image);
				},
				{ signal: controller.signal },
			);
		});
	}

	initImageLightboxes();
	document.addEventListener('astro:page-load', initImageLightboxes);
</script>
