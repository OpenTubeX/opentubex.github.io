---
/**
 * Custom theme menu: Dark / Light / Auto.
 * Preference is stored; `data-theme` on <html> is always the resolved light|dark.
 */
---

<div class="theme-select" data-theme-root>
	<button
		class="theme-select__button"
		type="button"
		data-theme-button
		aria-haspopup="listbox"
		aria-expanded="false"
		aria-controls="otx-theme-menu"
		aria-label="Select theme"
	>
		<svg class="theme-select__icon" data-theme-icon viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"
		></svg>
		<span class="theme-select__label" data-theme-label>Auto</span>
		<svg class="theme-select__caret" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
			<path fill="currentColor" d="M7.41 8.58 12 13.17l4.59-4.59L18 10l-6 6-6-6z"></path>
		</svg>
	</button>
	<ul class="theme-select__menu" id="otx-theme-menu" role="listbox" data-theme-menu hidden>
		<li role="option" tabindex="-1" data-theme-option data-value="auto" aria-selected="true">
			<svg class="theme-select__option-icon" data-theme-option-icon="auto" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"></svg>
			<span>Auto</span>
		</li>
		<li role="option" tabindex="-1" data-theme-option data-value="dark" aria-selected="false">
			<svg class="theme-select__option-icon" data-theme-option-icon="dark" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"></svg>
			<span>Dark</span>
		</li>
		<li role="option" tabindex="-1" data-theme-option data-value="light" aria-selected="false">
			<svg class="theme-select__option-icon" data-theme-option-icon="light" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"></svg>
			<span>Light</span>
		</li>
	</ul>
</div>

<template id="otx-theme-icons">
	<svg class="auto" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
		<path
			fill="currentColor"
			d="M4 6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v7H4V6Zm0 9h16v1a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-1Zm2-9v5h12V6H6Z"></path>
	</svg>
	<svg class="light" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
		<path
			fill="currentColor"
			d="M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10Zm0-5h1v3h-2V2h1Zm0 17h1v3h-2v-3h1ZM3.5 11H6.5v2H3.5v-2Zm14 0H20.5v2h-3v-2ZM5.64 4.22l1.42 1.42-2.12 2.12-1.42-1.42 2.12-2.12Zm12.02 12.02 1.42 1.42-2.12 2.12-1.42-1.42 2.12-2.12ZM4.22 18.36l1.42-1.42 2.12 2.12-1.42 1.42-2.12-2.12Zm12.02-12.02 1.42-1.42 2.12 2.12-1.42 1.42-2.12-2.12Z"
		></path>
	</svg>
	<svg class="dark" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
		<path
			fill="currentColor"
			d="M12.1 22c-5.52 0-10-4.48-10-10 0-4.77 3.35-8.76 7.85-9.77.4-.09.8.2.8.62v.18c0 4.42 3.58 8 8 8h.18c.42 0 .71.4.62.8C20.86 18.65 16.87 22 12.1 22Z"></path>
	</svg>
</template>
