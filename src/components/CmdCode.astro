---
import { Code } from 'astro-expressive-code/components';

interface Props {
	code: string;
	lang?: string;
	title?: string;
}

const { code, lang = 'shell', title } = Astro.props;
---

<div class="cmd-block">
	{
		title ? (
			<Code code={code} lang={lang} title={title} frame="code" />
		) : (
			<Code code={code} lang={lang} frame="code" />
		)
	}
</div>

<style is:global>
	/* Use the browser's own horizontal scroller, but pin its geometry so
	   Chromium does not grow/reposition the thumb on hover. */
	.cmd-block .expressive-code pre {
		scrollbar-width: auto !important;
		scrollbar-color: var(--scrollbar-thumb) transparent;
		-ms-overflow-style: auto !important;
	}

	.cmd-block .expressive-code pre::-webkit-scrollbar {
		display: block !important;
		width: 7px !important;
		height: 7px !important;
		background: transparent !important;
	}

	.cmd-block .expressive-code pre::-webkit-scrollbar-track {
		background: transparent !important;
	}

	.cmd-block .expressive-code pre::-webkit-scrollbar-thumb {
		min-width: 36px;
		border: 2px solid transparent !important;
		border-radius: 999px !important;
		background: var(--scrollbar-thumb) !important;
		background-clip: padding-box !important;
		cursor: grab;
	}

	.cmd-block .expressive-code pre::-webkit-scrollbar-thumb:hover {
		border: 2px solid transparent !important;
		background: var(--scrollbar-thumb-hover) !important;
		background-clip: padding-box !important;
		cursor: grab;
	}

	.cmd-block .expressive-code pre::-webkit-scrollbar-thumb:active {
		border: 2px solid transparent !important;
		background: var(--scrollbar-thumb-hover) !important;
		background-clip: padding-box !important;
		cursor: grabbing;
	}
</style>
