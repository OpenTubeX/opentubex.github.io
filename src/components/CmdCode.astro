---
import { Code } from 'astro-expressive-code/components';

interface Props {
	code: string;
	lang?: string;
	title?: string;
}

const { code, lang = 'shell', title } = Astro.props;
---

<div class="cmd-block">
	{
		title ? (
			<Code code={code} lang={lang} title={title} frame="code" />
		) : (
			<Code code={code} lang={lang} frame="code" />
		)
	}
</div>

<style is:global>
	/* The shared theme styles native scrollbars already. Keep the code pane as the
	   scroll container instead of mirroring it with a JavaScript scrollbar. */
	.cmd-block .expressive-code pre {
		scrollbar-width: thin !important;
		scrollbar-color: var(--scrollbar-thumb) var(--scrollbar-track);
		-ms-overflow-style: auto !important;
	}

	.cmd-block .expressive-code pre::-webkit-scrollbar {
		display: block !important;
		width: var(--scrollbar-size) !important;
		height: var(--scrollbar-size) !important;
	}
</style>
