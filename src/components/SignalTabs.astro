---
import { Icon } from 'astro-icon/components';

interface Tab {
	id: string;
	label: string;
	icon?: string;
}

interface Props {
	tabs: Tab[];
	syncKey?: string;
}

const { tabs, syncKey } = Astro.props;
const groupId = `tabs-${Math.random().toString(36).slice(2, 9)}`;
---

<div class="sig-tabs" data-sync-key={syncKey || undefined}>
	<div class="sig-tabs__list" role="tablist" aria-label="Options">
		{
			tabs.map((tab, index) => (
				<button
					type="button"
					class:list={['sig-tabs__tab', { 'is-active': index === 0 }]}
					role="tab"
					id={`${groupId}-tab-${tab.id}`}
					aria-selected={index === 0 ? 'true' : 'false'}
					aria-controls={`${groupId}-panel-${tab.id}`}
					tabindex={index === 0 ? 0 : -1}
					data-tab={tab.id}
					data-label={tab.label}
				>
					{tab.icon && <Icon name={tab.icon} aria-hidden="true" />}
					{tab.label}
				</button>
			))
		}
	</div>
	<div class="sig-tabs__panels">
		{
			tabs.map((tab, index) => (
				<div
					class:list={['sig-tabs__panel', { 'is-active': index === 0 }]}
					role="tabpanel"
					id={`${groupId}-panel-${tab.id}`}
					aria-labelledby={`${groupId}-tab-${tab.id}`}
					hidden={index !== 0}
					tabindex={0}
					data-panel={tab.id}
				>
					<slot name={tab.id} />
				</div>
			))
		}
	</div>
</div>

<script>
	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
	const transitions = new Map<HTMLElement, () => void>();

	function positionIndicator(root: HTMLElement) {
		const list = root.querySelector<HTMLElement>('.sig-tabs__list');
		const active = list?.querySelector<HTMLElement>('.is-active');
		if (!list || !active) return;
		list.style.setProperty('--tab-x', `${active.offsetLeft}px`);
		list.style.setProperty('--tab-y', `${active.offsetTop}px`);
		list.style.setProperty('--tab-width', `${active.offsetWidth}px`);
		list.style.setProperty('--tab-height', `${active.offsetHeight}px`);
		list.classList.add('has-indicator');
	}

	function switchPanels(root: HTMLElement, panels: HTMLElement[], tabId: string) {
		const container = root.querySelector<HTMLElement>('.sig-tabs__panels');
		const previous = panels.find((panel) => !panel.hidden);
		const next = panels.find((panel) => panel.dataset.panel === tabId);
		if (!container || !next || previous === next) return;

		// Continue interrupted transitions from the height currently on screen.
		const height = container.getBoundingClientRect().height;
		transitions.get(root)?.();
		panels.forEach((panel) => {
			const active = panel === next;
			panel.classList.toggle('is-active', active);
			panel.hidden = !active;
			panel.inert = !active;
			panel.setAttribute('aria-hidden', active ? 'false' : 'true');
		});

		if (!previous || reducedMotion.matches || root.dataset.bound !== 'true') return;
		const nextHeight = container.getBoundingClientRect().height;
		if (Math.abs(height - nextHeight) <= 1) return;
		container.classList.add('is-transitioning');
		const animation = container.animate(
			[{ height: `${height}px` }, { height: `${nextHeight}px` }],
			{
				duration: 300,
				easing: getComputedStyle(container).getPropertyValue('--ease').trim(),
				fill: 'both',
			},
		);
		const cleanup = () => {
			animation.cancel();
			container.classList.remove('is-transitioning');
			transitions.delete(root);
		};
		transitions.set(root, cleanup);
		void animation.finished.then(() => {
			if (transitions.get(root) === cleanup) cleanup();
		}, () => { /* An interrupted transition is cleaned up before its replacement. */ });
	}

	reducedMotion.addEventListener('change', () => {
		if (reducedMotion.matches) transitions.forEach((cleanup) => cleanup());
	});

	function activateTab(root: HTMLElement, tabId: string, persist: boolean) {
		const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
		const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
		const next = tabs.find((tab) => tab.dataset.tab === tabId);
		if (!next) return;

		tabs.forEach((tab) => {
			const active = tab === next;
			tab.classList.toggle('is-active', active);
			tab.setAttribute('aria-selected', active ? 'true' : 'false');
			tab.tabIndex = active ? 0 : -1;
		});

		positionIndicator(root);
		switchPanels(root, panels, tabId);

		const syncKey = root.dataset.syncKey;
		if (persist && syncKey) {
			try {
				localStorage.setItem(`otx-synced-tabs__${syncKey}`, next.dataset.label || tabId);
			} catch {
				/* ignore */
			}

			document.querySelectorAll<HTMLElement>(`.sig-tabs[data-sync-key="${syncKey}"]`).forEach((other) => {
				if (other === root) return;
				const otherTab = [...other.querySelectorAll<HTMLButtonElement>('[role="tab"]')].find(
					(tab) => tab.dataset.label === next.dataset.label,
				);
				if (otherTab?.dataset.tab) activateTab(other, otherTab.dataset.tab, false);
			});
		}
	}

	function restoreSynced(root: HTMLElement) {
		const syncKey = root.dataset.syncKey;
		if (!syncKey) return;
		try {
			const label = localStorage.getItem(`otx-synced-tabs__${syncKey}`);
			if (!label) return;
			const match = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')].find(
				(tab) => tab.dataset.label === label,
			);
			if (match?.dataset.tab) activateTab(root, match.dataset.tab, false);
		} catch {
			/* ignore */
		}
	}

	function bindTabs(root: HTMLElement) {
		if (root.dataset.bound === 'true') return;
		restoreSynced(root);
		positionIndicator(root);
		const resizeObserver = new ResizeObserver(() => {
			transitions.get(root)?.();
			positionIndicator(root);
		});
		root.querySelectorAll('.sig-tabs__list, .sig-tabs__tab').forEach((element) => resizeObserver.observe(element));
		root.dataset.bound = 'true';

		root.querySelectorAll<HTMLButtonElement>('[role="tab"]').forEach((tab) => {
			tab.addEventListener('click', () => {
				if (tab.dataset.tab) activateTab(root, tab.dataset.tab, true);
			});

			tab.addEventListener('keydown', (event) => {
				const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
				const index = tabs.indexOf(tab);
				let nextIndex = index;
				if (event.key === 'ArrowRight' || event.key === 'ArrowDown') nextIndex = (index + 1) % tabs.length;
				else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp')
					nextIndex = (index - 1 + tabs.length) % tabs.length;
				else if (event.key === 'Home') nextIndex = 0;
				else if (event.key === 'End') nextIndex = tabs.length - 1;
				else return;
				event.preventDefault();
				tabs[nextIndex]?.focus();
				const id = tabs[nextIndex]?.dataset.tab;
				if (id) activateTab(root, id, true);
			});
		});
	}

	document.querySelectorAll<HTMLElement>('.sig-tabs').forEach(bindTabs);
</script>
